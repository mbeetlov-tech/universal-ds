{
  "name": "@uds/components",
  "version": "0.1.0",
  "description": "Universal DS — React components (copy-paste / shadcn-style)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
